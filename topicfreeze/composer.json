{
    "name": "ecyaz/topicfreeze",
    "type": "phpbb-extension",
    "description": "Lets moderators freeze a topic: members can still reply, but every reply waits for moderator approval.",
    "homepage": "https://github.com/ECYaz/phpBB-Ext",
    "version": "1.0.1",
    "license": "GPL-2.0-only",
    "authors": [
        { "name": "ECYaz" }
    ],
    "require": {
        "php": ">=7.1.3"
    },
    "extra": {
        "display-name": "Topic Freeze",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.2,<4.0.0@dev"
        },
        "version-check": {
            "host": "raw.githubusercontent.com",
            "directory": "/ECYaz/phpBB-Ext/main/versioncheck",
            "filename": "topicfreeze.json",
            "ssl": true
        }
    }
}
